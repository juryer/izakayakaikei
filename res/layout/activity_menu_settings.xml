<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:paddingTop="32dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← 戻る"
            android:background="@null"
            android:textColor="#888888"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="メニュー登録"
            android:textSize="18sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 追加フォーム -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="新しい商品を追加"
                        android:textSize="11sp"
                        android:textColor="#AAAAAA"
                        android:layout_marginBottom="8dp"/>

                    <RadioGroup
                        android:id="@+id/rgCategory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <RadioButton
                            android:id="@+id/rbDrink"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="飲み物"
                            android:checked="true"/>

                        <RadioButton
                            android:id="@+id/rbFood"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="食べ物"/>

                    </RadioGroup>

                    <!-- 商品名・値段 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="商品名"
                            android:textSize="12sp"
                            android:textColor="#888888"/>

                        <EditText
                            android:id="@+id/etMenuName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="例：ビール"
                            android:inputType="text"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="販売価格"
                            android:textSize="12sp"
                            android:textColor="#888888"/>

                        <EditText
                            android:id="@+id/etMenuPrice"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="例：500"
                            android:inputType="number"/>

                    </LinearLayout>

                    <!-- 原価入力（売上計算設定オンのみ表示） -->
                    <LinearLayout
                        android:id="@+id/costInputRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="原価"
                            android:textSize="12sp"
                            android:textColor="#888888"/>

                        <EditText
                            android:id="@+id/etMenuCost"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="例：200"
                            android:inputType="number"/>

                    </LinearLayout>

                    <Button
                        android:id="@+id/btnAddMenuItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="追加"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#1D9E75"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 飲み物リスト -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍺 飲み物"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1D9E75"
                android:layout_marginBottom="6dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/drinkEmpty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="まだ登録されていません"
                        android:textColor="#AAAAAA"
                        android:padding="8dp"/>

                    <LinearLayout
                        android:id="@+id/drinkListLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 食べ物リスト -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍴 食べ物"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#D85A30"
                android:layout_marginBottom="6dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/foodEmpty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="まだ登録されていません"
                        android:textColor="#AAAAAA"
                        android:padding="8dp"/>

                    <LinearLayout
                        android:id="@+id/foodListLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="12dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- チーム名・修正・削除ボタン -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/teamName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btnTeamDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="内訳・修正"
                    android:textColor="#185FA5"
                    android:backgroundTint="#E6F1FB"
                    android:textSize="12sp"
                    android:padding="6dp"
                    android:layout_marginEnd="4dp"
                    android:visibility="gone"/>

                <Button
                    android:id="@+id/btnDeleteTeam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="削除"
                    android:textColor="#E24B4A"
                    android:backgroundTint="#FFEEEE"
                    android:textSize="12sp"
                    android:padding="6dp"/>

            </LinearLayout>

            <!-- ラベル・自動削除テキスト（非表示用） -->
            <TextView
                android:id="@+id/teamStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/teamItemCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#AAAAAA"
                android:textSize="12sp"/>

            <!-- 合計金額 -->
            <TextView
                android:id="@+id/teamTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#CCCCCC"
                android:layout_marginBottom="10dp"/>

            <!-- 注文を追加するボタン -->
            <Button
                android:id="@+id/btnOpenTeam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="注文を追加する"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1D9E75"
                android:textSize="15sp"
                android:padding="12dp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
